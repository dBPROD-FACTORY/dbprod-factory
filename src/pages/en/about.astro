---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.jsx";
import site from "../../data/site.json";

const statsEn = [
  { v: "200+", l: "Hours of dubbing delivered" },
  { v: "100+", l: "Projects completed" },
  { v: "150+", l: "Voices cast" },
  { v: "9+", l: "Years of experience" },
  { v: "92%", l: "Positive feedback" },
  { v: "4", l: "Fully equipped studios" },
];

const pillars = [
  { num: "01", icon: "mic", title: "Broadcast quality", body: "Neumann / Universal Audio signal chain, Genelec monitoring, certified acoustic isolation. Our deliverables meet EBU R128 and Dolby Atmos standards at no extra cost." },
  { num: "02", icon: "globe", title: "International agility", body: "Trilingual (Arabic · French · English), fast turnarounds, available seven days a week. We work at the pace of a European studio, with the flexibility of Morocco." },
  { num: "03", icon: "users", title: "Tailored casting", body: "Over 150 listed voice actors — native, professional, available. We match the right voice to every role, every tone, every audience." },
];

const timeline = [
  { year: "2016", title: "Founding", desc: "Our first studio opens in Casablanca, launching our earliest dubbing projects for the French-speaking Maghreb market." },
  { year: "2018", title: "Voice expansion", desc: "Launch of our voice-over and casting department, and the start of our roster of 150+ listed voice actors." },
  { year: "2020", title: "Post-production", desc: "Full audio post-production brought in-house: sound design, 5.1 / Dolby Atmos mixing, and broadcast mastering." },
  { year: "2022", title: "Premium clients", desc: "Partnerships formed with Netflix MENA, Canal+ Afrique, and several US and European production studios." },
  { year: "2025", title: "Today", desc: "4 studios, 200+ hours delivered, 100+ projects, and a presence in 15+ countries. The journey continues." },
];
---
<Base title="About" description="dB PROD·FACTORY: your partner for French dubbing services from Casablanca. European standards, the agility of the South, since 2016." lang="en" altHref="/about">

  <!-- ── HERO ───────────────────────────────────────────────────── -->
  <section style="padding:160px 0 80px;">
    <div class="container">
      <div class="eyebrow" style="margin-bottom:28px;">About · Est. 2016</div>
      <h1 class="h-display" style="font-size:clamp(56px,10vw,160px);margin:0 0 60px;max-width:1200px;line-height:0.9;">
        An <em style="font-style:italic;color:var(--accent);">integrated</em> studio<br/>at the crossroads of worlds.
      </h1>
      <div class="grid-responsive-2" style="display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:flex-start;">
        <p class="h-serif" style="font-size:22px;line-height:1.55;margin:0;">
          Founded in Casablanca in 2016, dB PROD·FACTORY was built on a simple conviction: deliver broadcast-quality French dubbing services from Morocco, blending European standards with the agility of the South.
        </p>
        <p class="text-dim" style="font-size:16px;line-height:1.7;margin:0;">
          Ten years on, we've delivered over 200 hours of production — dubbing, voice-over, and post-production — for clients across France, the Maghreb, the Middle East, and the United States. Our team brings together voice actors, sound engineers, adapters, and artistic directors, each chosen for their exacting standards.
        </p>
      </div>
    </div>
  </section>

  <!-- ── STATS ──────────────────────────────────────────────────── -->
  <section style="border-top:1px solid var(--line);border-bottom:1px solid var(--line);">
    <div class="container">
      <div class="stats-grid" style="display:grid;grid-template-columns:repeat(6,1fr);gap:0;">
        {statsEn.map((s, i) => (
          <div style={`padding:40px 24px;border-left:${i === 0 ? "none" : "1px solid var(--line)"};`}>
            <div class="h-display" style="font-size:clamp(40px,4.5vw,64px);margin-bottom:8px;">{s.v}</div>
            <div class="mono" style="font-size:10px;">{s.l}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── PILLARS ────────────────────────────────────────────────── -->
  <section style="padding:120px 0;background:var(--bg-elev);">
    <div class="container">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:80px;flex-wrap:wrap;gap:32px;">
        <div>
          <div class="eyebrow" style="margin-bottom:24px;">(01) Our DNA</div>
          <h2 class="h-display" style="font-size:clamp(48px,6vw,96px);margin:0;">
            Three pillars,<br/><em style="font-style:italic;color:var(--accent);">one</em> standard.
          </h2>
        </div>
        <p class="text-dim" style="font-size:16px;max-width:400px;line-height:1.65;margin:0;padding-bottom:8px;">
          Every project is handled with the rigor of international broadcast. These are the principles that guide every session.
        </p>
      </div>

      <div class="grid-responsive-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:2px;background:var(--line);">
        {pillars.map(v => (
          <div class="card" style="border-radius:0;border:none;padding:48px 40px;background:var(--bg);">
            <div style="width:52px;height:52px;border-radius:12px;border:1px solid var(--line-2);display:grid;place-items:center;color:var(--accent);margin-bottom:32px;">
              <Icon name={v.icon} size={22} stroke={1.5} />
            </div>
            <div class="mono" style="margin-bottom:12px;">{v.num}</div>
            <h3 class="h-serif" style="font-size:26px;margin:0 0 16px;">{v.title}</h3>
            <p class="text-dim" style="font-size:15px;line-height:1.65;margin:0;">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── TIMELINE ───────────────────────────────────────────────── -->
  <section style="padding:120px 0;">
    <div class="container">
      <div class="eyebrow" style="margin-bottom:40px;">(02) History</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:flex-start;" class="grid-responsive-2">
        <h2 class="h-display" style="font-size:clamp(48px,6vw,88px);margin:0;line-height:0.9;">
          From Casablanca<br/><em style="font-style:italic;color:var(--accent);">to the</em> world.
        </h2>
        <div style="display:flex;flex-direction:column;gap:0;">
          {timeline.map((e) => (
            <div style="display:grid;grid-template-columns:80px 1fr;gap:24px;padding:28px 0;border-bottom:1px solid var(--line);">
              <span class="h-display" style="font-size:28px;color:var(--accent);line-height:1;">{e.year}</span>
              <div>
                <div style="font-weight:600;font-size:16px;margin-bottom:6px;">{e.title}</div>
                <p class="text-dim" style="font-size:14px;line-height:1.6;margin:0;">{e.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── EQUIPMENT ──────────────────────────────────────────────── -->
  <section style="padding:100px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--bg-elev);">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 2fr;gap:80px;align-items:flex-start;" class="grid-responsive-2">
        <div>
          <div class="eyebrow" style="margin-bottom:24px;">(03) Equipment</div>
          <h2 class="h-display" style="font-size:clamp(40px,5vw,72px);margin:0 0 24px;line-height:0.95;">
            Pro<br/><em style="font-style:italic;color:var(--accent);">gear.</em>
          </h2>
          <p class="text-dim" style="font-size:15px;line-height:1.65;margin:0;">
            We've invested in sound quality from day one. Every link in our chain is built to deliver a broadcast-ready result.
          </p>
          <a href="/studios" class="btn btn-ghost btn-arrow" style="margin-top:28px;">Visit our studios</a>
        </div>
        <div class="equip-inner" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          {[
            { cat: "Microphones", items: ["Neumann TLM 103", "AKG C414 XLS", "Sennheiser MKH 416"] },
            { cat: "Interfaces", items: ["Universal Audio Apollo X8", "UA Apollo Twin X", "Focusrite Scarlett"] },
            { cat: "DAW / Plugins", items: ["Pro Tools Ultimate", "Waves Complete", "iZotope RX 11"] },
            { cat: "Monitoring", items: ["Genelec 8040B", "Yamaha HS8", "Beyerdynamic DT 990"] },
          ].map(g => (
            <div style="border:1px solid var(--line);border-radius:16px;padding:24px;">
              <div class="mono" style="margin-bottom:16px;font-size:10px;">{g.cat}</div>
              <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px;">
                {g.items.map(item => (
                  <li style="font-size:14px;color:var(--fg-dim);display:flex;align-items:center;gap:8px;">
                    <span style="width:4px;height:4px;border-radius:50%;background:var(--accent);flex-shrink:0;"></span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ────────────────────────────────────────────────────── -->
  <section style="padding:120px 0;text-align:center;">
    <div class="container">
      <div class="eyebrow" style="margin-bottom:28px;justify-content:center;">(04) Working together</div>
      <h2 class="h-display" style="font-size:clamp(52px,8vw,120px);margin:0 auto 40px;max-width:900px;line-height:0.9;">
        Your next project<br/><em style="font-style:italic;color:var(--accent);">deserves the best</em>.
      </h2>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="/en/contact" class="btn btn-primary btn-arrow">Request a free quote</a>
        <a href="/en/services" class="btn btn-ghost btn-arrow">See our services</a>
      </div>
    </div>
  </section>

</Base>

<style>
  @media (max-width: 480px) {
    .equip-inner { grid-template-columns: 1fr !important; }
  }
</style>
