---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import HeroHome from "../../components/HeroHome.jsx";
import ProjectCard from "../../components/ProjectCard.jsx";
import PostCard from "../../components/PostCard.jsx";
import Icon from "../../components/Icon.jsx";
import { AudioPlayer } from "../../components/Waveform.jsx";
import site from "../../data/site.json";

const services = (await getCollection("services")).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const servicesEn = services.slice(0, 8).map(s => s.data);

const projects = (await getCollection("projects")).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const featured = projects.filter(p => p.data.featured).slice(0, 3).map(p => p.data);

const posts = (await getCollection("postsEn")).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const enPosts = posts.slice(0, 3).map(p => p.data);

const hero = {
  eyebrow: "Studio · Casablanca — 33.5731°N / 7.5898°W",
  onAir: "Session in progress · Studio B",
  headline: ["Your", "studio,", "in Morocco"],
  italic: "dubbing",
  intro: "dB PROD·FACTORY has been delivering French dubbing services, voice-over, subtitling and audio description since 2016 — 200+ hours of production in French, Arabic and English for broadcast, film and streaming platforms.",
  cta1: "Request a quote",
  cta2: "See our work",
};

const statsEn = [
  { v: "200+", l: "Hours of dubbing delivered" },
  { v: "100+", l: "Projects completed" },
  { v: "150+", l: "Voices cast" },
  { v: "9+", l: "Years of experience" },
  { v: "92%", l: "Positive feedback" },
  { v: "4", l: "Fully equipped studios" },
];

const samplesEn = [
  { title: "Youssef K. — deep voice, FR", artist: "VO · 0:38", duration: 38, seed: 3 },
  { title: "Leila M. — warm voice, AR", artist: "DUBBING · 0:52", duration: 52, seed: 7 },
  { title: "Omar B. — young voice, FR/AR", artist: "IVR · 0:24", duration: 24, seed: 11 },
];

const testimonial = { q: "Very professional and fun experience.", n: "Wafae Takieddine", r: "Voice actress" };
---

<Base title="dB PROD·FACTORY" description="dB PROD·FACTORY delivers French dubbing services, voice-over, subtitling and audio description from Casablanca, Morocco — 200+ hours of production for broadcast, film and streaming platforms worldwide." lang="en" altHref="/">
  <HeroHome client:load hero={hero} projects={featured} locale="en" />

  {/* STATS */}
  <section style="padding:80px 0;border-bottom:1px solid var(--line);">
    <div class="container">
      <div class="stats-grid" style="display:grid;grid-template-columns:repeat(6,1fr);gap:0;">
        {statsEn.map((s, i) => (
          <div style={`padding:20px 24px;border-left:${i === 0 ? "none" : "1px solid var(--line)"};`}>
            <div class="h-display" style="font-size:clamp(28px,7.5vw,56px);margin-bottom:4px;">{s.v}</div>
            <div class="mono" style="font-size:10px;">{s.l}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* SERVICES */}
  <section style="padding:140px 0;position:relative;">
    <div class="container">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:80px;flex-wrap:wrap;gap:40px;">
        <div>
          <div class="eyebrow" style="margin-bottom:28px;">(01) Services</div>
          <h2 class="h-display" style="font-size:clamp(52px,7vw,104px);margin:0;max-width:900px;">
            12 disciplines.<br/><em style="font-style:italic;color:var(--accent);">One</em> studio.
          </h2>
        </div>
        <a href="/en/services" class="btn btn-ghost btn-arrow">All services</a>
      </div>

      <div style="border:1px solid var(--line);border-radius:24px;overflow:hidden;background:var(--bg-elev);">
        {servicesEn.map((s, i) => (
          <a href={`/en/services/${s.id}`} class="svc-row"
             style={`display:grid;grid-template-columns:80px 1fr 2fr 1fr auto;gap:24px;align-items:center;padding:28px 32px;border-top:${i === 0 ? "none" : "1px solid var(--line)"};color:var(--fg);text-decoration:none;transition:background 0.3s var(--ease);position:relative;overflow:hidden;`}>
            <span class="svc-num mono" style="font-size:12px;">{s.num}</span>
            <div style="display:flex;align-items:center;gap:16px;">
              <div style="width:44px;height:44px;border-radius:10px;border:1px solid var(--line-2);display:grid;place-items:center;color:var(--accent);flex-shrink:0;">
                <Icon name={s.icon} size={20} stroke={1.5} />
              </div>
              <span class="h-serif" style="font-size:clamp(18px,2.5vw,28px);">{s.title_en || s.title}</span>
            </div>
            <span class="svc-desc text-dim" style="font-size:14px;">{s.short_en || s.short}</span>
            <div class="svc-tag">{s.tag && <span class="chip chip-accent">{s.tag}</span>}</div>
            <Icon name="arrowUpRight" size={20} stroke={1.5} />
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* FEATURED PROJECTS */}
  <section style="padding:0 0 140px;">
    <div class="container">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:60px;flex-wrap:wrap;gap:40px;">
        <div>
          <div class="eyebrow" style="margin-bottom:28px;">(02) Portfolio</div>
          <h2 class="h-display" style="font-size:clamp(52px,7vw,104px);margin:0;">
            Recent <em style="font-style:italic;color:var(--accent);">work</em>.
          </h2>
        </div>
        <a href="/en/portfolio" class="btn btn-ghost btn-arrow">Full portfolio</a>
      </div>

      <div class="grid-responsive-3 mobile-carousel" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;align-items:stretch;">
        {featured.map((p) => (
          <ProjectCard client:visible project={p} size="lg" locale="en" />
        ))}
      </div>
    </div>
  </section>

  {/* SAMPLES */}
  <section style="padding:100px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--bg-elev);position:relative;overflow:hidden;">
    <div class="container">
      <div class="grid-responsive-2" style="display:grid;grid-template-columns:1fr 2fr;gap:60px;align-items:center;">
        <div>
          <div class="eyebrow" style="margin-bottom:24px;">(03) Samples</div>
          <h3 class="h-display" style="font-size:72px;margin:0;line-height:0.9;margin-bottom:24px;">
            Hear the <em style="font-style:italic;color:var(--accent);">grain</em>.
          </h3>
          <p class="text-dim" style="font-size:15px;max-width:400px;margin-bottom:28px;">
            A few recent extracts — voice, ambience, mix. Casting available on request.
          </p>
          <a href="/voix" class="link-arrow">
            Full voice bank <Icon name="arrow" size={16} stroke={1.5} />
          </a>
        </div>
        <div style="display:flex;flex-direction:column;gap:12px;">
          {samplesEn.map(s => (
            <AudioPlayer client:visible title={s.title} artist={s.artist} duration={s.duration} seed={s.seed} />
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* TESTIMONIAL */}
  <section style="padding:100px 0;">
    <div class="container" style="max-width:720px;text-align:center;">
      <div class="eyebrow" style="margin-bottom:40px;justify-content:center;">(04) Testimonial</div>
      <p class="h-serif" style="font-size:28px;line-height:1.4;margin:0 0 24px;">"{testimonial.q}"</p>
      <div style="font-size:14px;font-weight:500;">{testimonial.n}</div>
      <div class="mono" style="font-size:10px;margin-top:4px;color:var(--fg-dim);">{testimonial.r}</div>
    </div>
  </section>

  {/* BLOG */}
  {enPosts.length > 0 && (
    <section style="padding:80px 0;">
      <div class="container">
        <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:60px;">
          <div>
            <div class="eyebrow" style="margin-bottom:28px;">(05) Blog</div>
            <h2 class="h-display" style="font-size:clamp(52px,6vw,88px);margin:0;">Latest articles</h2>
          </div>
          <a href="/en/blog" class="btn btn-ghost btn-arrow">All articles</a>
        </div>
        <div class="grid-responsive-3 mobile-carousel" style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;">
          {enPosts.map(p => (
            <PostCard post={p} locale="en" />
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
